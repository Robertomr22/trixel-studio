{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node tools/*)",
      "Bash(npm run *)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(npm ls*)",
      "Bash(npm outdated*)",
      "Bash(npm audit*)",
      "Bash(npx astro *)",
      "Bash(npx playwright *)",
      "Bash(npx vitest *)",
      "Bash(npx drizzle-kit *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git -C clientes/*)",
      "Bash(docker compose -f docker-compose.bd.yml *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git -C clientes/* push*)",
      "Bash(npm publish*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(sftp *)",
      "Bash(ftp *)",
      "Bash(curl -X POST*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.test)",
      "Read(**/.env.local)",
      "Read(**/.env.production)"
    ]
  }
}
