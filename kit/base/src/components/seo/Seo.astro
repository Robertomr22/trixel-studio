---
/**
 * Metadatos de una página: title, description, canonical, Open Graph y robots.
 * Lo usa Base.astro; no hace falta incluirlo a mano.
 */
import { negocio } from '../../data/negocio';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta de imagen para compartir (1200×630), relativa al sitio o absoluta. */
  imagen?: string | undefined;
  noindex?: boolean | undefined;
}

const { titulo, descripcion, imagen, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, negocio.sitio.url).href;
const imagenAbsoluta = imagen ? new URL(imagen, negocio.sitio.url).href : undefined;
const bloquearIndexado = noindex || negocio.esDemo;
---

<title>{titulo}</title>
<meta name="description" content={descripcion} />
<link rel="canonical" href={canonical} />
{bloquearIndexado && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="es_ES" />
<meta property="og:site_name" content={negocio.nombre} />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descripcion} />
<meta property="og:url" content={canonical} />
{imagenAbsoluta && <meta property="og:image" content={imagenAbsoluta} />}
<meta name="twitter:card" content={imagenAbsoluta ? 'summary_large_image' : 'summary'} />
